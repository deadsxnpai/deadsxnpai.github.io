{
  "name": "expo-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --clean",
    "build:web": "expo export --platform web",
    "build:mobile": "expo export",
    "deploy": "npm run build:web && gh-pages -d dist",
    "deploy:clean": "npm run build:web && gh-pages -d dist -t true"
  },
  "dependencies": {
    "@apollo/client": "^3.9.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-cookies/cookies": "react-native-cookies/cookies",
    "expo": "~56.0.0",
    "expo-blur": "~56.0.3",
    "expo-dev-client": "^56.0.20",
    "expo-head": "^0.0.20",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "^56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "^56.0.5",
    "graphql": "^16.8.0",
    "graphql-ws": "^6.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
