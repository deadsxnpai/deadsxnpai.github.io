{
  "expo": {
    "name": "tsu-mobile",
    "slug": "tsu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tsumobile",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.tsutmb.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/shared/assets/android-icon-foreground.png",
        "backgroundImage": "./src/shared/assets/android-icon-background.png",
        "monochromeImage": "./src/shared/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.tsutmb.app"
    },
    "web": {
      "favicon": "./src/shared/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
