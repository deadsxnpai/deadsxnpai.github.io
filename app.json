{
	"expo": {
		"name": "Мой ТГУ",
		"slug": "tsu-mobile",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./src/shared/assets/logo/favicon.png",
		"userInterfaceStyle": "light",
		"scheme": "tsumobile",
		"platforms": ["ios", "android", "web"],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "ru.tsutmb.app"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./src/shared/assets/img/android-icon-foreground.png",
				"backgroundImage": "./src/shared/assets/img/android-icon-background.png",
				"monochromeImage": "./src/shared/assets/img/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "ru.tsutmb.app"
		},
		"web": {
			"favicon": "./src/shared/assets/logo/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-web-browser",
			"expo-status-bar",
			"expo-secure-store"
		]
	}
}
